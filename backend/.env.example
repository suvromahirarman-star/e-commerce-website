# Server Environment Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Secrets & Configuration
JWT_ACCESS_SECRET=aura_super_secure_jwt_access_secret_2026_change_in_production
JWT_REFRESH_SECRET=aura_super_secure_jwt_refresh_secret_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Supabase / PostgreSQL Configuration
# Database Connection String for PostgreSQL (pg pool)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API Credentials for Storage & Admin APIs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=aura-product-images

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
